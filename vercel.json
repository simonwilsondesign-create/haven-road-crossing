{
  "functions": {
    "api/*.js": {
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/?history=48",
      "permanent": false,
      "missing": [
        { "type": "query", "key": "history" }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
